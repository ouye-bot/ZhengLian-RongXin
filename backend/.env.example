# ============================================
# 证链融信（FinZkTrust）系统环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ============================================
# SM4 主密钥配置（必填）
# ============================================
# SM4 对称加密密钥，用于加密敏感业务数据（余额、积分等）
# 格式：32位十六进制字符串（128位密钥）
# 生成命令：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SM4_MASTER_KEY=<your-32-hex-chars-sm4-key>

# ============================================
# 区块链配置
# ============================================

# 区块链后端选择: "hardhat"（默认本地私链） 或 "fisco-bcos"（联盟链）
BLOCKCHAIN_NETWORK=hardhat

# --- Hardhat 本地私链配置 ---

# Hardhat 本地私链 RPC 地址
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Hardhat 本地私链 Chain ID (31337 是 Hardhat 默认私链ID)
BLOCKCHAIN_CHAIN_ID=31337

# 交易签名私钥（64位十六进制，前缀0x）- 用于本地私链自动签名上链
# 生成命令：node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# 注意：知名测试私钥（Hardhat 默认账户、geth 文档测试钥等）将被启动校验拒绝
HARDHAT_PRIVATE_KEY=<your-64-hex-private-key-with-0x-prefix>

# --- FISCO BCOS 联盟链配置 ---

# FISCO BCOS JSON-RPC 地址
FISCO_BCOS_RPC_URL=http://127.0.0.1:8545

# FISCO BCOS 群组 ID
FISCO_BCOS_GROUP_ID=1

# FISCO BCOS 链 ID
FISCO_BCOS_CHAIN_ID=1

# FISCO BCOS Console 路径（用于写操作的 Channel 协议）
FISCO_BCOS_CONSOLE_PATH=~/fisco-bcos-node/console

# FISCO BCOS 交易签名私钥（用于 sendRawTransaction）
# 默认使用 FISCO BCOS 测试私钥，生产环境必须替换
FISCO_BCOS_PRIVATE_KEY=0x<你的FISCO部署账户私钥，64位hex；可用 node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))" 生成后在链上授权>

# 智能合约地址（部署后自动填充）
CONTRACT_ADDRESS=

# ============================================
# 服务器配置
# ============================================

# 服务器端口（默认 3003）
PORT=3003

# JWT 签名密钥（必填，至少32个字符）
JWT_SECRET=<your-jwt-secret-min-32-chars>

# JWT Refresh 密钥（必填，至少32个字符，不能与 JWT_SECRET 相同）
JWT_REFRESH_SECRET=<your-jwt-refresh-secret-min-32-chars>

# Session 密钥（必填，至少32个字符）
SESSION_SECRET=<your-session-secret-min-32-chars>

# ============================================
# 数据库配置 - MySQL
# ============================================

# 数据库主机（默认 localhost）
DB_HOST=localhost

# 数据库端口（默认 3306）
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码（不能使用弱密码如 123456）
DB_PASSWORD=<your-db-password>

# 数据库名称（默认 finzktrust）
DB_NAME=finzktrust

# ============================================
# 日志配置
# ============================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# 测试豁免开关
# ============================================
# 默认不设置（等效关闭）。生产环境必须保持 OFF。
# 开启（ON）后：perfuser 账号与携带 x-test-mode: benchmark 头的请求
# 将豁免通用限流（express-rate-limit skip），不绕过认证、SM2 签名、
# 防重放等任何安全链检查。
# ALLOW_TEST_BYPASS=ON

# ============================================
# 功能开关
# ============================================

# 是否启用区块链存证功能
ENABLE_BLOCKCHAIN=true

# 是否自动部署合约（开发环境）
AUTO_DEPLOY_CONTRACT=false

# ============================================
# 风控增强插件配置
# ============================================

# 开关：ON=启用，OFF=禁用（默认禁用）
FEATURE_RISK_ENHANCE=OFF

# 保证金相关配置
MARGIN_BASE_RATE=0.20
MARGIN_MIN_RATE=0.15
MARGIN_MAX_RATE=0.25
MARGIN_INTEREST_RATE=0.0035

# 担保相关配置
GUARANTEE_FEE_RATE_MULTIPLIER=0.15
GUARANTEE_INSURANCE_FUND_RATIO=0.20
GUARANTEE_BORROWER_REWARD_RATIO=0.10
GUARANTEE_COMPENSATION_THRESHOLD_DAYS=15
GUARANTEE_MAX_RATIO_TO_NET_ASSET=2.0
GUARANTEE_MAX_ACTIVE_CONTRACTS=5

# 担保人资格条件
GUARANTEE_MIN_CREDIT_SCORE=650
GUARANTEE_MIN_REGISTRATION_DAYS=180

# 通知配置
NOTIFICATION_EXPIRE_DAYS=30

# ---- 本地凭据文件（不入库，部署时自备）----
# backend/config/fisco/account.key、gmsdk.key、gmca.crt、gmsdk.crt：FISCO BCOS SDK/Console 国密证书与账户私钥，
#   由 build_chain.sh 生成的节点目录 sdk/ 复制而来；contracts/artifacts/deployer.pem：Hardhat 部署账户 PEM。
